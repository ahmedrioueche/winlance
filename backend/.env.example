SECRET_KEY=replace-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,winlance.onrender.com,.onrender.com

# Supabase Postgres (Session pooler). Dashboard → Project Settings → Database → Connection string.
# Create separate projects for winlance-dev and winlance-prod; never share credentials.
POSTGRES_DB=postgres
POSTGRES_USER=postgres.<PROJECT_REF>
POSTGRES_PASSWORD=<DATABASE_PASSWORD>
POSTGRES_HOST=aws-0-<REGION>.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require

# Local Docker Postgres alternative (when not using Supabase):
# POSTGRES_DB=winlance
# POSTGRES_USER=winlance
# POSTGRES_PASSWORD=winlance
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=disable

# Host-side defaults. Compose overrides these to rabbitmq/redis service names.
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Dev: True runs tasks inline (recommended without a Celery worker).
CELERY_TASK_ALWAYS_EAGER=True
DEFAULT_FROM_EMAIL=noreply@winlance.local
SOCIAL_AUTH_ENABLED_PROVIDERS=google
SOCIAL_AUTH_GOOGLE_CLIENT_ID=your-google-client-id
SOCIAL_AUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
SOCIAL_AUTH_GITHUB_CLIENT_ID=
SOCIAL_AUTH_GITHUB_CLIENT_SECRET=
DEMO_ACCOUNTS_ENABLED=False
AI_COACH_PROVIDER=mock
# Production (required when DJANGO_SETTINGS_MODULE=config.settings.prod)
# SECRET_KEY=replace-with-a-long-random-string
# ALLOWED_HOSTS=api.example.com
# CORS_ALLOWED_ORIGINS=https://app.example.com
# SENTRY_DSN=
# REDIS_CACHE_URL=redis://redis:6379/2
# LOG_LEVEL=INFO
